# This is a public package published to the public npm registry.
# Pin the registry so installs (and CI) never inherit an internal/private
# registry from a contributor's global ~/.npmrc, which would poison
# package-lock.json with unreachable resolved URLs.
registry=https://registry.npmjs.org/
@gsa-sam:registry=https://registry.npmjs.org/

# test-app pins Angular 9 / TS 2.3 against the Angular 19 library; suppress
# false peer-dep conflicts that npm >=7 would otherwise hard-fail on.
legacy-peer-deps=true
